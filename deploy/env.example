# Copy to deploy/.env and adjust. Never commit real values. Secrets stay empty in this file.
# Production: .env lives on the server with mode 0600, owned by the deploy user (docs/10 section 3.7).

# --- Application (docs/08 section 5) ---
# development or production
DESTELLO_ENV=development
DESTELLO_PUBLIC_URL=http://localhost:8080
# Local only. Production Caddy listens on :8080 behind the NGINX edge (Caddyfile.prod).
DESTELLO_SITE_ADDRESS=:80
DESTELLO_DEFAULT_RELEASE=all
DESTELLO_PIPELINE_VERSION=0.3.0
DESTELLO_DATA_DIR=/data
# Host directory bind mounted at /data. Local: ../data. Production: /srv/destello/data
DESTELLO_DATA_HOST_DIR=../data
# Static demo bundle served by Caddy at /demo/ (same origin fallback when the API is down).
DESTELLO_DEMO_DIR=/srv/destello/demo
DESTELLO_DATA_QUOTA_GB=120
# The API measures the presets (spectrum, astrometry) in the background so visitors find them cached.
DESTELLO_PREWARM_MEASUREMENTS=true
DESTELLO_REDIS_URL=redis://redis:6379/0
DESTELLO_DB_URL=sqlite:////data/db/destello.sqlite
DESTELLO_IRSA_CONCURRENCY=8
# Cutout source: s3 (AWS open data copy, range reads, IRSA fallback per image) or irsa.
DESTELLO_CUTOUT_SOURCE=s3
# Global bound on concurrent S3 range requests (all API and worker processes).
DESTELLO_S3_CONCURRENCY=16
DESTELLO_HTTP_TIMEOUT_S=30
# Egress allowlist (SSRF control, docs/10 section 3.2). Comma separated host names.
DESTELLO_EGRESS_ALLOWLIST=irsa.ipac.caltech.edu,gea.esac.esa.int,mast.stsci.edu,simbad.cds.unistra.fr,cds.unistra.fr,vizier.cds.unistra.fr,alasky.cds.unistra.fr,vizier.idia.ac.za,ssd-api.jpl.nasa.gov,ssd.jpl.nasa.gov,nasa-irsa-spherex.s3.us-east-1.amazonaws.com,nasa-irsa-wise.s3.us-west-2.amazonaws.com,ws.cadc-ccda.hia-iha.nrc-cnrc.gc.ca,ws-cadc.canfar.net,challenges.cloudflare.com
# Where remote data may come from: offline (cache only), online, hybrid (cache first).
DESTELLO_DATA_MODE=hybrid

# --- Abuse protection ---
# Set to true only in local development to skip Turnstile verification. Production forces false.
DESTELLO_TURNSTILE_DISABLED=true
# Cloudflare Turnstile secret key (server side). Empty here.
DESTELLO_TURNSTILE_SECRET=
# Salt for hashing client IPs in logs and rate limits. Generate with: openssl rand -hex 32
DESTELLO_IP_HASH_SALT=
# Secret for Hunt opaque field ids, vote tokens and gold placement (F-35). Set a stable value in
# production (generate with: openssl rand -hex 32). Empty uses a random value per process, so ids
# and tokens change on restart (development only).
DESTELLO_HUNT_SECRET=

# --- Candidate reports (F-22) ---
# Daily report database backup. Empty means <data_dir>/backups/reports (same volume);
# in production point it at a second disk or a mounted storage box.
DESTELLO_REPORTS_BACKUP_DIR=
DESTELLO_REPORTS_BACKUP_KEEP=14

# --- Production only (docker-compose.prod.yml) ---
# Public host name (Cloudflare proxied, then NGINX on the edge proxy): destello.felicabrera.com
DESTELLO_DOMAIN=
# Owner (user or organization) of the GHCR images: ghcr.io/<owner>/destello-backend
DESTELLO_GHCR_OWNER=
# Address and port where Caddy listens for the edge proxy. Use the private address of the application host, never a public one.
DESTELLO_BIND_ADDR=127.0.0.1
DESTELLO_HTTP_PORT=8080
# Optional site banner text (docs/09 section 10)
DESTELLO_NOTICE=

# --- Frontend build time variables (read by Vite, public values only) ---
VITE_API_BASE=/api/v1
# Static demo host, for example https://demo.destello.example (Cloudflare Pages)
VITE_DEMO_BASE=
# Turnstile public site key. Empty hides the widget (development only).
VITE_TURNSTILE_SITEKEY=
# Address shown on the About page for report deletion requests. Empty shows a generic text.
VITE_CONTACT_EMAIL=
# Public site origin without a trailing slash (https://example.org). Used for canonical links, Open Graph URLs,
# the sitemap and llms.txt. Empty: the browser uses its own origin, and the build files use http://localhost:8080.
VITE_PUBLIC_URL=
# Release tag sent with browser error reports (the deploy workflow sets the commit SHA).
VITE_RELEASE=
